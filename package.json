{
  "name": "assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Employees table take-home assignment (NestJS + React)",
  "license": "ISC",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose -f server/db/docker-compose.yml up -d",
    "db:down": "docker compose -f server/db/docker-compose.yml down",
    "start:server": "npm run start:dev -w server",
    "start:client": "npm run dev -w client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:start:server\" \"npm:start:client\"",
    "lint": "npm run lint -w server && npm run lint -w client",
    "format": "prettier --write \"{client,server}/src/**/*.{ts,tsx,css}\" \"*.{json,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "multer": "^2.4.0"
  }
}

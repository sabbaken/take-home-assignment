# Copy to `.env` and adjust. The server reads these on boot and has no
# fallbacks in code — a missing or malformed value stops the start with a
# message naming the variable.
#
# The values below are the ones the assignment's MySQL container ships with,
# so they work as-is against `npm run db:up`.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=assignment_db
